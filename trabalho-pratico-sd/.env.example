# ==============================================================================
# VARIÁVEIS DE AMBIENTE DE PERSISTÊNCIA MONGODB - PROJETO DIVERTERAPIA
# Copie este arquivo para ".env" na raiz (trabalho-pratico-sd/.env) se desejar
# personalizar as conexões das 3 instâncias MongoDB.
# ==============================================================================

# ------------------------------------------------------------------------------
# Opção 1: 3 Containers Docker locais (padrão do docker-compose.yml)
# ------------------------------------------------------------------------------
# URI exclusiva do Controlador 1 (Líder Primário - Porta gRPC 3001)
MONGO_URI_1=mongodb://127.0.0.1:27017/diverterapia
# URI exclusiva do Controlador 2 (Réplica Honesta / Líder Interino - Porta gRPC 3002)
MONGO_URI_2=mongodb://127.0.0.1:27018/diverterapia
# URI exclusiva do Controlador 3 (Réplica Bizantina Toggleável - Porta gRPC 3003)
MONGO_URI_3=mongodb://127.0.0.1:27019/diverterapia

# ------------------------------------------------------------------------------
# Opção 2: Instância única local ou MongoDB Atlas com 3 databases isolados
# (Descomente e ajuste usuário/senha/cluster caso não utilize o Docker Compose)
# ------------------------------------------------------------------------------
# MONGO_URI_1=mongodb+srv://usuario:senha@cluster.mongodb.net/diverterapia_db_1?retryWrites=true&w=majority
# MONGO_URI_2=mongodb+srv://usuario:senha@cluster.mongodb.net/diverterapia_db_2?retryWrites=true&w=majority
# MONGO_URI_3=mongodb+srv://usuario:senha@cluster.mongodb.net/diverterapia_db_3?retryWrites=true&w=majority
