{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "mqtt-broker/**/*",
    "sensores/**/*",
    "atuadores/**/*",
    "controladores/**/*"
  ],
  "exclude": [
    "node_modules",
    "cliente-dashboard"
  ]
}

